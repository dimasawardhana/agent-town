{
  "name": "ai-town-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test:art": "./node_modules/.bin/esbuild --bundle --format=esm --platform=node --outfile=ui-art.test.mjs test/art.test.ts --log-level=warning && node --test ui-art.test.mjs",
    "test:visibility": "./node_modules/.bin/esbuild --bundle --format=esm --platform=node --outfile=ui-visibility.test.mjs test/visibility.test.ts --log-level=warning && node --test ui-visibility.test.mjs",
    "test": "npm run test:art && npm run test:visibility && npm run test:light && npm run test:atlas",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:light": "./node_modules/.bin/esbuild --bundle --format=esm --platform=node --outfile=ui-light.test.mjs test/light.test.ts --log-level=warning && node --test ui-light.test.mjs",
    "test:atlas": "./node_modules/.bin/esbuild --bundle --format=esm --platform=node --outfile=ui-atlas.test.mjs test/atlas.test.ts --log-level=warning && node --test ui-atlas.test.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
